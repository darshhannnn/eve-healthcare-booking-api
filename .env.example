# EVE Healthcare API — example configuration.
# Copy to `.env` and adjust. Every value is optional in development; the app
# falls back to the defaults below (SQLite + in-memory cache).

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for zero-setup local development...
DATABASE_URL=sqlite:///./eve_dev.db
# ...or PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql+psycopg://eve:eve@db:5432/eve

# JWT — MUST be changed in any shared/production environment
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# HMAC-SHA256 secret used to verify /payments/webhook signatures.
# Empty disables verification (development only — always set in production).
WEBHOOK_SECRET=

# Bootstrap admin, created at startup if missing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=EVE Admin

# Seed sample centres/tests/demo user on startup
SEED_DEMO_DATA=false
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo@12345

# Simple fixed-window rate limit per IP (0 disables).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_MUTATIONS_PER_MINUTE=60
# Key limits on X-Forwarded-For instead of the socket peer —
# enable ONLY behind a proxy that overwrites that header.
TRUST_PROXY_HEADERS=false

# Expose /docs, /redoc and /openapi.json (set false in production)
DOCS_ENABLED=true

# Read cache for centres/tests endpoints: "memory" (default) or "redis"
CACHE_BACKEND=memory
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
CACHE_CENTRES_TTL_SECONDS=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
